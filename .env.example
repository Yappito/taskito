# PostgreSQL
POSTGRES_USER="taskito"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="taskito"

# Auth.js
AUTH_URL="https://taskito.example.com"
# Generate with: openssl rand -base64 32
# The example value below MUST be changed before deploying.
AUTH_SECRET="u+iyAx2MGvgOwM88gK8zNma6A8w+dUUyM9fCe8pn5c4="

# Optional auto-tagger (OpenAI-compatible API)
AUTO_TAGGER_URL=""
AUTO_TAGGER_API_KEY=""

# AI provider secret encryption key (base64-encoded 32-byte key).
# REQUIRED in production: there is no fallback to AUTH_SECRET.
# Generate with: openssl rand -base64 32
AI_SECRET_MASTER_KEY=""

# Optional comma-separated AI provider host allowlist
AI_PROVIDER_HOST_ALLOWLIST=""

# Optional AI provider request timeout in milliseconds
AI_PROVIDER_REQUEST_TIMEOUT_MS="90000"

# Optional upload storage backend: local or s3
STORAGE_PROVIDER="local"
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_SESSION_TOKEN=""
STORAGE_S3_FORCE_PATH_STYLE="false"
STORAGE_S3_PREFIX=""

# Optional: set to true only when you intentionally want demo data
ALLOW_DEMO_SEED="false"

# Secret protecting cron endpoints (e.g. /api/cron/process-recurring).
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# Optional OIDC single-provider SSO (uncomment to enable)
# OIDC_ISSUER="https://idp.example.com"
# OIDC_CLIENT_ID="taskito"
# OIDC_CLIENT_SECRET=""
# OIDC_PROVIDER_ID="oidc"
# OIDC_PROVIDER_NAME="OIDC"
# OIDC_SCOPE="openid email profile"
# OIDC_GROUPS_CLAIM="groups"
# OIDC_DEFAULT_ROLE="member"
# OIDC_ALLOW_SIGNUP="true"
# OIDC_ALLOW_EMAIL_ACCOUNT_LINKING="false"
# OIDC_REQUIRE_EMAIL_VERIFIED="false"
# OIDC_ADMIN_EMAILS=""
# OIDC_PROVIDERS='[]'
