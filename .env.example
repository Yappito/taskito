# PostgreSQL
POSTGRES_USER="taskito"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="taskito"

# Auth.js
AUTH_URL="https://taskito.example.com"
AUTH_SECRET="replace-with-a-cryptographically-strong-secret"

# Optional auto-tagger (OpenAI-compatible API)
AUTO_TAGGER_URL=""
AUTO_TAGGER_API_KEY=""

# AI provider secret encryption (base64-encoded 32-byte key)
# Strongly recommended in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_SECRET_MASTER_KEY=""

# Optional comma-separated AI provider host allowlist. Each entry is `host` or
# `host:port` (IPv6 literals bracketed, e.g. `[::1]:11434`). A bare `host` entry
# matches any port on PUBLIC hosts; private/loopback hosts require an exact
# `host:port` entry (e.g. `localhost:11434`) — or AI_PROVIDER_ALLOW_PRIVATE_HOSTS=true —
# so an allowlist entry can never open every TCP port on a host.
AI_PROVIDER_HOST_ALLOWLIST=""

# Allow AI provider base URLs to point at loopback/private/link-local addresses.
# Off by default; set true only to support self-hosted providers (Ollama, LM Studio, etc.)
AI_PROVIDER_ALLOW_PRIVATE_HOSTS="false"

# Optional AI provider request timeout in milliseconds
AI_PROVIDER_REQUEST_TIMEOUT_MS="90000"

# Explicit opt-in to deriving the secret encryption key from AUTH_SECRET when
# AI_SECRET_MASTER_KEY is unset. Required for AI to start in production without
# a master key; not recommended. Ignored outside production.
AI_ALLOW_AUTH_SECRET_FALLBACK=""

# Optional upload storage backend: local or s3
STORAGE_PROVIDER="local"
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="us-east-1"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_SESSION_TOKEN=""
STORAGE_S3_FORCE_PATH_STYLE="false"
STORAGE_S3_PREFIX=""

# Optional SMTP email delivery for notifications and the daily due-soon digest.
# SMTP_FROM is required to enable the email channel.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Set "false" only for self-signed certificates; default is true.
SMTP_TLS_REJECT_UNAUTHORIZED="true"
# Refuses to send SMTP credentials without TLS by default. Set "true" only for
# trusted/local relays that never offer STARTTLS and cannot use implicit TLS.
SMTP_ALLOW_INSECURE_AUTH="false"
# TCP connect / implicit-TLS / STARTTLS handshake deadline in milliseconds.
SMTP_CONNECT_TIMEOUT_MS="10000"
# Hard per-message SMTP conversation deadline in milliseconds.
SMTP_MESSAGE_TIMEOUT_MS="60000"

# Optional: set to true only when you intentionally want demo data
ALLOW_DEMO_SEED="false"

# Built-in in-process scheduler for recurring tasks + due-date automation rules.
# Set to false only if you drive POST /api/cron/process-recurring with an external cron.
SCHEDULER_ENABLED="true"

# Scheduler tick interval in milliseconds (default 60000; min 1000)
SCHEDULER_INTERVAL_MS="60000"

# Maximum duration of one scheduler tick's work in milliseconds. Jobs are
# cancelled between units when the budget is exceeded (default 600000 = 10
# minutes). The tick holds a transaction-scoped Postgres advisory lock inside
# an interactive transaction that is kept open for the whole run on a
# dedicated single-connection client.
SCHEDULER_TICK_TIMEOUT_MS="600000"

# Interactive-transaction timeout (milliseconds) for the scheduler lock
# transaction itself. The xact advisory lock is taken inside it and the tick's
# jobs are awaited while it stays open, so this must comfortably exceed the
# longest possible run (SCHEDULER_TICK_TIMEOUT_MS + job overrun) — Prisma
# would otherwise abort the transaction, releasing the lock mid-run (default
# 86400000 = 24 hours).
SCHEDULER_LOCK_TX_TIMEOUT_MS="86400000"

# Earliest UTC hour at which the built-in scheduler sends the daily due-soon
# digest email (default 7). Invalid values fall back to the default.
SCHEDULER_DIGEST_HOUR_UTC="7"

# Bearer token for the external cron endpoint POST /api/cron/process-recurring.
# Leave empty to keep that endpoint disabled (503) while the built-in scheduler runs.
# Compared with a constant-time check; use a long random value (e.g. `openssl rand -base64 32`).
CRON_SECRET=""

# Allow outbound webhook URLs to point at loopback/private/link-local addresses
# (e.g. an n8n instance on the same host). Off by default: webhook targets must
# be public hosts; a URL that is or resolves to a private address is rejected
# at creation AND re-checked at every send. Set true only in environments where
# self-hosted webhook receivers are intentional.
WEBHOOK_ALLOW_PRIVATE_HOSTS="false"
WEBHOOK_MAX_WEBHOOKS_PER_PROJECT="20"
WEBHOOK_DELIVERY_CONCURRENCY="5"
# Claim lease for `processing` deliveries; never below preflight + request
# timeout (the lease must outlive one full send cycle: URL validation + DNS +
# one bounded POST).
WEBHOOK_DELIVERY_LEASE_MS="300000"
# Send-time URL/DNS preflight budget per attempt (must fit inside the lease).
WEBHOOK_PREFLIGHT_BUDGET_MS="15000"
# Outbound POST timeout; lease floor = WEBHOOK_PREFLIGHT_BUDGET_MS + this.
WEBHOOK_TIMEOUT_MS="10000"
# Depth cap for the in-process inline delivery queue; overflow falls back to
# the durable `pending` rows + scheduler sweep (bounded memory).
WEBHOOK_DELIVERY_QUEUE_MAX_DEPTH="100"

# Due-date automation rules run as the rule's CREATOR and only while that user
# still holds `automation_manage` plus the action's underlying project permission
# (task_update / task_comment / task_archive). Rules whose creator is missing or
# disabled are skipped — nothing runs with elevated or fallback identity.
